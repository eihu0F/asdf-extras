#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$(dirname "$current_script_path")")")

# shellcheck source=./common.bash
source "${plugin_dir}/lib/commands/common.bash"

update_all() {
	local plugin latest

	command asdf plugin update --all

	while IFS= read -r plugin; do
		[[ -n "$plugin" ]] || continue
		if ! extras_has_installed_versions "$plugin"; then
			continue
		fi

		latest="$(extras_latest_version "$plugin")"
		[[ -n "$latest" ]] || continue
		command asdf install "$plugin" "$latest"
	done < <(extras_plugins)
}

update_one() {
	local plugin="$1"
	local version="${2:-}"
	local latest

	command asdf plugin update "$plugin"

	if [[ -n "$version" ]]; then
		command asdf install "$plugin" "$version"
		command asdf set -u "$plugin" "$version"
		return 0
	fi

	latest="$(extras_latest_version "$plugin")"
	[[ -n "$latest" ]] || extras_fail "no available version for plugin: $plugin"
	command asdf install "$plugin" "$latest"
	command asdf set -u "$plugin" "$latest"
}

main() {
	extras_need_args 1 "$#" "asdf cmd extras update <all|plugin> [version]"

	local target="$1"
	if [[ "$target" == "all" ]]; then
		update_all
		return 0
	fi

	update_one "$target" "${2:-}"
}

main "$@"
