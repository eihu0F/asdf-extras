#!/usr/bin/env bash

set -euo pipefail

# Every asdf call of an initialized shell passes through here, so avoid spawning
# processes (such as dirname) to find the runtime.
current_script_path=${BASH_SOURCE[0]}
[[ "$current_script_path" == /* || "$current_script_path" == ./* || "$current_script_path" == ../* ]] || current_script_path="./$current_script_path"
libexec_dir="${current_script_path%/*}"
extras_root="${libexec_dir%/*}"
dispatcher="${extras_root}/lib/extras/dispatch.bash"

exec bash "$dispatcher" installed "$@"
