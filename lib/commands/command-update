#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$(dirname "$current_script_path")")")

# shellcheck source=./common.bash
source "${plugin_dir}/lib/commands/common.bash"

resolve_latest_target() {
	local plugin="$1"
	local latest_output target

	latest_output="$(command asdf latest "$plugin" 2>/dev/null || true)"
	target="$(printf "%s\n" "$latest_output" | awk 'NR==1 {print $NF}')"

	if [[ -z "$target" || "$target" == ")" || "$target" == "(" ]]; then
		return 1
	fi

	if ! extras_version_exists "$plugin" "$target"; then
		return 1
	fi

	printf "%s\n" "$target"
}

update_all() {
	local plugin

	command asdf plugin update --all

	while IFS= read -r plugin; do
		[[ -n "$plugin" ]] || continue
		if ! update_one_internal "$plugin" ""; then
			printf "asdf-extras: skipped %s (unable to resolve latest version)\n" "$plugin" >&2
		fi
	done < <(extras_plugins)
}

update_one_internal() {
	local plugin="$1"
	local version="${2:-}"
	local current target activated

	current="$(extras_current_version "$plugin")"

	if [[ -n "$version" ]]; then
		target="$version"
		if ! extras_version_exists "$plugin" "$target"; then
			printf "asdf-extras: target version is unavailable for plugin: %s (%s)\n" "$plugin" "$target" >&2
			return 1
		fi
	else
		target="$(resolve_latest_target "$plugin" || true)"
		if [[ -z "$target" ]]; then
			printf "asdf-extras: no available version for plugin: %s\n" "$plugin" >&2
			return 1
		fi
	fi

	if [[ "$current" == "$target" ]]; then
		printf "asdf-extras: %s already current at %s\n" "$plugin" "$target"
		return 0
	fi

	command asdf install "$plugin" "$target"
	command asdf set -u "$plugin" "$target"
	activated="$(extras_current_version "$plugin")"

	if ! extras_version_installed "$plugin" "$target"; then
		printf "asdf-extras: target version is not installed after update: %s (%s)\n" "$plugin" "$target" >&2
		return 1
	fi

	if [[ "$activated" != "$target" ]]; then
		printf "asdf-extras: target version did not become current; keep previous version: %s (current=%s, target=%s)\n" "$plugin" "${activated:-none}" "$target" >&2
		return 1
	fi

	if [[ -n "$current" ]]; then
		command asdf uninstall "$plugin" "$current"
	fi
}

update_one() {
	local plugin="$1"
	local version="${2:-}"

	command asdf plugin update "$plugin"
	if ! update_one_internal "$plugin" "$version"; then
		extras_fail "unable to resolve target version for plugin: $plugin"
	fi
}

main() {
	local target="${1:-all}"
	if [[ "$target" == "all" ]]; then
		update_all
		return 0
	fi

	update_one "$target" "${2:-}"
}

main "$@"
