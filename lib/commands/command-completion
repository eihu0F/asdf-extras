#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$(dirname "$current_script_path")")")
extras_bin="${plugin_dir}/libexec/asdf-extras"

# shellcheck source=./common.bash
source "${plugin_dir}/lib/commands/common.bash"

main() {
	extras_need_args 1 "$#" "asdf-extras completion <bash|zsh|fish|elvish|nushell>"

	local shell_name="$1"

	case "$shell_name" in
	bash | zsh | fish | elvish | nushell)
		command asdf completion "$shell_name"
		printf "\n# asdf-extras init overlay\n"
		"$extras_bin" init "$shell_name"
		;;
	*)
		extras_fail "unsupported shell: $shell_name"
		;;
	esac
}

main "$@"
