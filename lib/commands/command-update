#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$(dirname "$current_script_path")")")

# shellcheck source=./common.bash
source "${plugin_dir}/lib/commands/common.bash"

update_all() {
	local plugin

	command asdf plugin update --all

	while IFS= read -r plugin; do
		[[ -n "$plugin" ]] || continue
		update_one_internal "$plugin" ""
	done < <(extras_plugins)
}

update_one_internal() {
	local plugin="$1"
	local version="${2:-}"
	local current target

	current="$(extras_current_version "$plugin")"

	if [[ -n "$version" ]]; then
		target="$version"
	else
		target="$(extras_latest_version "$plugin")"
		[[ -n "$target" ]] || extras_fail "no available version for plugin: $plugin"
	fi

	if [[ "$current" == "$target" ]]; then
		printf "asdf-extras: %s already current at %s\n" "$plugin" "$target"
		return 0
	fi

	command asdf install "$plugin" "$target"
	command asdf set -u "$plugin" "$target"

	if [[ -n "$current" ]]; then
		command asdf uninstall "$plugin" "$current"
	fi
}

update_one() {
	local plugin="$1"
	local version="${2:-}"

	command asdf plugin update "$plugin"
	update_one_internal "$plugin" "$version"
}

main() {
	extras_need_args 1 "$#" "asdf cmd asdf-extras update <all|plugin> [version]"

	local target="$1"
	if [[ "$target" == "all" ]]; then
		update_all
		return 0
	fi

	update_one "$target" "${2:-}"
}

main "$@"
