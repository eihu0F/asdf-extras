#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"
find "${ASDF_DOWNLOAD_PATH:?}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +

# Export requested version from the plugin checkout.
download_release "$plugin_dir" "$ASDF_INSTALL_VERSION" "$ASDF_DOWNLOAD_PATH"
