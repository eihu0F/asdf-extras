#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$(dirname "$current_script_path")")")

# shellcheck source=./common.bash
source "${plugin_dir}/lib/commands/common.bash"

main() {
	local arg plugin version
	local -a install_opts=()
	local -a positional=()
	local use_home=0
	local use_parent=0
	local set_scope="--home"

	for arg in "$@"; do
		case "$arg" in
		-u | --home)
			# `-u` is treated as shorthand for `--home` by this wrapper.
			# Do not pass it to `asdf install`; it is consumed by `asdf set` scope.
			use_home=1
			;;
		-p | --parent)
			# `-p` is treated as shorthand for `--parent` by this wrapper.
			# Do not pass it to `asdf install`; it is consumed by `asdf set` scope.
			use_parent=1
			;;
		-*)
			install_opts+=("$arg")
			;;
		*)
			positional+=("$arg")
			;;
		esac
	done

	if ((use_home == 1 && use_parent == 1)); then
		extras_fail "-u/--home and -p/--parent cannot be used together"
	fi

	if ((use_parent == 1)); then
		set_scope="--parent"
	fi

	# Bash 3.2 treats empty arrays as unset under nounset; guard their expansion.
	set -- ${positional[@]+"${positional[@]}"}
	extras_need_args 2 "$#" "asdf-extras install [options] <plugin> <version>"

	plugin="$1"
	version="$2"

	extras_prepare_install_environment "$plugin" "$version"

	command asdf install ${install_opts[@]+"${install_opts[@]}"} "$plugin" "$version"
	command asdf set "$set_scope" "$plugin" "$version"
}

main "$@"
