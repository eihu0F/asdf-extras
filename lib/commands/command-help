#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$(dirname "$current_script_path")")")

# shellcheck source=./common.bash
source "${plugin_dir}/lib/commands/common.bash"

version="$(extras_self_version)"

printf "asdf-extras %s\n\n" "$version"

cat <<'EOF'
Usage:
  asdf-extras <subcommand>
  asdf-extras --version

Fallback (when asdf-extras is not installed):
  asdf cmd asdf-extras <subcommand>

Subcommands:
  completion <bash|zsh|fish|elvish|nushell>
  init bash
  install [--home|-u|--parent|-p|--local] <plugin> <version>
  update [--home|-u|--parent|-p|--local] [all|<plugin> [version]]
  version

Scopes (install and update):
  --home, -u    Home configuration (default); update removes replaced versions
  --parent, -p  Closest existing parent configuration; keep previous versions
  --local       Current directory configuration; keep previous versions
  Scope options cannot be combined. Home/local files are created when needed.
  Parent scope fails if no parent configuration exists.
  Explicitly scoped bulk updates only process plugins listed in that scope file.
  Unscoped update processes all plugins, one plugin update/install at a time.
EOF
